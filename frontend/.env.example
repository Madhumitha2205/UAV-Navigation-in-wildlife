# Backend 1: Global Route Planning API (GA + 2-Opt + A*)
VITE_GLOBAL_API_URL=http://localhost:8000

# Backend 2: Local Controller, AirSim & Safety Layer API (TD3 + AFL)
VITE_CONTROL_API_URL=http://localhost:8001

# WebSocket URL for real-time UAV telemetry stream
VITE_WS_URL=ws://localhost:8001/ws/telemetry

# Initial default mode: 'true' for standalone interactive demo mode, 'false' for live backend connection
VITE_DEMO_MODE=true
